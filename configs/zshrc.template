export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="powerlevel10k/powerlevel10k"

# ==============================
# PLUGINS
# ==============================
plugins=(
  git
  zsh-autosuggestions
  zsh-syntax-highlighting
  you-should-use
)

source $ZSH/oh-my-zsh.sh

# ==============================
# HISTÓRICO
# ==============================
HISTSIZE=10000
SAVEHIST=10000
HISTFILE=~/.zsh_history
setopt HIST_IGNORE_DUPS       # não salva duplicatas consecutivas
setopt HIST_IGNORE_ALL_DUPS   # remove duplicatas mais antigas
setopt HIST_IGNORE_SPACE      # ignora comandos que começam com espaço
setopt HIST_VERIFY            # confirma antes de executar histórico expandido
setopt SHARE_HISTORY          # compartilha histórico entre sessões abertas

# ==============================
# AMBIENTE
# ==============================
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export EDITOR="code"          # troque por "vim", "nano", etc. se preferir

# Homebrew (macOS Apple Silicon)
[[ -f /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"

# ==============================
# ALIASES — NAVEGAÇÃO
# ==============================
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias ~="cd ~"

# ==============================
# ALIASES — LISTAGEM
# ==============================
alias ls="ls --color=auto"
alias ll="ls -lhF"
alias la="ls -lhAF"
alias lt="ls -lhFt"      # ordenado por data
alias lS="ls -lhFS"      # ordenado por tamanho

# macOS usa 'gls' do coreutils se instalado
if command -v gls &>/dev/null; then
  alias ls="gls --color=auto"
fi

# ==============================
# ALIASES — GIT
# ==============================
alias gs="git status"
alias ga="git add"
alias gaa="git add ."
alias gc="git commit -m"
alias gca="git commit --amend --no-edit"
alias gp="git push"
alias gpf="git push --force-with-lease"
alias gl="git pull"
alias glog="git log --oneline --graph --decorate --all"
alias gd="git diff"
alias gds="git diff --staged"
alias gco="git checkout"
alias gcb="git checkout -b"
alias gbr="git branch"
alias gbrd="git branch -d"
alias gst="git stash"
alias gstp="git stash pop"

# ==============================
# ALIASES — UTILITÁRIOS
# ==============================
alias cls="clear"
alias reload="source ~/.zshrc"
alias zshconfig="$EDITOR ~/.zshrc"
alias hosts="sudo $EDITOR /etc/hosts"
alias ip="curl -s https://ipinfo.io/ip"

# ==============================
# POWERLEVEL10K
# ==============================
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
